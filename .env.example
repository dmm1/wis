# Copy to .env and fill in. Never commit .env.

# --- Neon Postgres (EU region, e.g. aws-eu-central-1 / Frankfurt) ---
# Pooled endpoint (host contains "-pooler"): used by the app. RLS context is set with SET LOCAL inside transactions.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/wis?sslmode=require
# Direct (unpooled) endpoint: used by migrations and pg-boss (LISTEN/NOTIFY, advisory locks).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/wis?sslmode=require

# --- App ---
# Public base URL of the web app (used for auth callbacks, invitation links).
APP_URL=http://localhost:3000

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
