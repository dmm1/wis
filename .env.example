# Copy to .env.local (or .env) and fill in. Never commit it. .env.local wins over .env.

# --- Neon Postgres (EU region, e.g. aws-eu-central-1 / Frankfurt) ---
# Pooled endpoint (host contains "-pooler"): used by the app. RLS context is set with SET LOCAL inside transactions.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/wis?sslmode=verify-full
# Direct (unpooled) endpoint: used by migrations and pg-boss (LISTEN/NOTIFY, advisory locks).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/wis?sslmode=verify-full

# --- App ---
# Public base URL of the web app (used for auth callbacks, invitation links).
APP_URL=http://localhost:3000
# local | production. Production enables secure cookies + e-mail verification and requires a real mailer.
APP_ENV=local

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Mail (Resend, https://resend.com) ---
# Optional locally (links are printed to the console). Required when APP_ENV=production.
# The sender domain must be verified in Resend (SPF/DKIM). Use an EU region in Resend for GDPR.
RESEND_API_KEY=
MAIL_FROM="WIS <no-reply@your-verified-domain.example>"
